# Copy to .env (local / Node hosts) or add in your host's Environment Variables settings.

# ---- Which AI service answers the guide ----
# "anthropic" (default) or "openai" = any OpenAI-compatible service
# (OpenAI, Google Gemini, Groq, OpenRouter, Mistral, a local Ollama...)
AI_PROVIDER=anthropic
AI_API_KEY=your-key-here

# Model name from your provider's model list.
# Required for "openai"; optional for "anthropic" (default claude-sonnet-5-5).
AI_MODEL=

# Only for "openai": the service's OpenAI-compatible address
#   OpenAI      https://api.openai.com/v1                              (default)
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1   (local only, no key needed: put any text)
AI_BASE_URL=

# ---- Optional ----
MAX_TOKENS=
RATE_LIMIT_PER_10_MIN=30
# Only accept requests from your own site, e.g. https://combustion-atlas.vercel.app
ALLOWED_ORIGIN=
